# Porta do Servidor
PORT=3333

# Ambiente
NODE_ENV=development

# URL de Conexão com o Banco de Dados (Prisma)
# Para desenvolvimento local ágil, podemos usar SQLite ou PostgreSQL
DATABASE_URL="file:./dev.db"

# Segredo de Assinatura JWT (Auth)
JWT_SECRET="seu_segredo_super_secreto_jwt_verzel_2026"
JWT_EXPIRES_IN="7d"

# Segredo para Assinatura Criptográfica do QR Code (Anti-Fraude)
QR_SECRET_KEY="seu_segredo_hmac_para_validacao_qr_code"

# Chaves das APIs Externas
TMDB_API_KEY="sua_chave_tmdb_aqui"
TICKETMASTER_API_KEY="sua_chave_ticketmaster_aqui"
